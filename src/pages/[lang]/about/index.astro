---
/** About: the long text (anchors #informatics #lineage #how-we-work #join) and contact. */
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Contact from '../../../components/Contact.astro';
import { useTranslations, langPaths, type Lang } from '../../../i18n/utils';
import { aboutPage } from '../../../lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const page = await aboutPage(lang);
const { Content } = await render(page);
---

<Base lang={lang} title={t('about.title')} description={page.data.lede}>
  <PageHeader title={page.data.title} lede={page.data.lede} />
  <div class="about about-page">
    <div class="prose"><Content /></div>
    <aside><Contact lang={lang} /></aside>
  </div>
</Base>
